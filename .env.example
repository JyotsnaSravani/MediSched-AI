# Database Configuration
DATABASE_URL=postgresql://medisched_user:medisched_pass@localhost:5432/medisched_db

# Redis Configuration (for Celery and Channels)
REDIS_URL=redis://:medisched_redis_pass@localhost:6379/0

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# Twilio Configuration (Sprint 3 - AI Calling System)
# Sign up at: https://www.twilio.com/try-twilio
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Configuration (Sprint 3 - Whisper Transcription)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Site URL (for Twilio webhooks)
# For local development with ngrok: https://your-subdomain.ngrok.io
# For production: https://yourdomain.com
SITE_URL=http://127.0.0.1:8000

# Email Configuration (for Sprint 4)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
